{
  "name": "dum-tum",
  "version": "0.0.4",
  "description": "One-command installer for fixit.zsh — typo + AI shell helper for macOS and Ubuntu",
  "bin": {
    "dum-tum": "bin/dum-tum.js"
  },
  "scripts": {
    "postinstall": "node bin/postinstall.js",
    "install-fixit": "bash install.sh",
    "test": "bash tests/run-tests.sh"
  },
  "files": [
    "bin/",
    "src/",
    "install.sh",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjunagi-a-rehman/dum-tum.git"
  },
  "keywords": [
    "zsh",
    "shell",
    "typo",
    "openrouter",
    "opencode",
    "claude",
    "claude-code",
    "codex",
    "cli",
    "fixit"
  ],
  "author": "arjunagi-a-rehman",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "preferGlobal": true
}
